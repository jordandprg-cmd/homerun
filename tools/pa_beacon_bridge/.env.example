# Copy to `.env` (same folder as smart_money_bridge.py) and fill in.
# This file is read by the bridge only; it never leaves the machine.

# ---- Telegram (required) ------------------------------------------------
# https://my.telegram.org -> API development tools -> create an application.
# Any app name/short-name works; the values you need are api_id and api_hash.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The PA Beacon forum. A t.me/c/<N>/... link means the peer id is -100<N>,
# so t.me/c/3761522274/... -> -1003761522274. Already the default; override
# here only if you point the bridge at a different group.
# TELEGRAM_CHAT=-1003761522274

# ---- homerun backend ----------------------------------------------------
# homerun's docker-compose publishes the backend as
#   127.0.0.1:${BACKEND_PORT:-8000}:8000
# Note the 127.0.0.1 — the port is bound to loopback only, so this default
# works only when the bridge runs ON the same PC as the containers.
HOMERUN_BASE_URL=http://localhost:8000

# ---- Behaviour ----------------------------------------------------------
# false  -> qualified wallets are queued; you run `inject` yourself.
# true   -> the daemon pushes them into homerun automatically.
AUTO_INJECT=false

# glossary (default, offline, zero deps) | argos (offline neural) | deep (cloud)
TRANSLATE_BACKEND=glossary

# Composite score a wallet must clear to be injected (0-100).
MIN_SCORE=55

LOG_LEVEL=INFO
